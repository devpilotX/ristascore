# ---- Core ----
# Postgres connection string. With docker compose this is set for you.
DATABASE_URL="postgresql://rishta:rishta@localhost:5432/rishtascore?schema=public"

# Public base URL of the app. Used for badge links and QR codes.
PUBLIC_BASE_URL="http://localhost:3000"

# ---- Auth ----
# Auth.js secret. Generate with: openssl rand -base64 32
# The app refuses to start in production if this is missing or a placeholder.
NEXTAUTH_SECRET="change-me-in-production-please-use-a-long-random-value"
AUTH_TRUST_HOST="true"

# Cookie and security flags. Set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE="false"

# ---- Seed admin (created by the seed script) ----
ADMIN_EMAIL="admin@rishtascore.local"
ADMIN_PASSWORD="Admin@12345"

# ---- Background jobs (optional) ----
# If REDIS_URL is set, verification runs go through a BullMQ queue and a worker.
# If it is empty, verification runs synchronously (fine for local dev).
REDIS_URL=""

# ---- Verification mode ----
# "sandbox" (default) runs simulated, clearly-labelled checks with no external
# accounts. "live" routes each check to its real provider (only those with
# credentials below actually run; others report "pending"). See VERIFICATION.md.
VERIFICATION_MODE="sandbox"

# DigiLocker / UIDAI / PAN (Government ID check)
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""
DIGILOCKER_REDIRECT_URI=""
# Account Aggregator / EPFO (Employment & Income check)
AA_CLIENT_ID=""
AA_CLIENT_SECRET=""
AA_BASE_URL=""
# National Academic Depository (Education check)
NAD_API_KEY=""
NAD_BASE_URL=""
# eCourts (Marital status + criminal record support)
ECOURTS_API_KEY=""
ECOURTS_BASE_URL=""
# Police clearance / BGV agency (Criminal record check)
POLICE_API_KEY=""
POLICE_BASE_URL=""

# ---- Payments: master switch ----
# Payments are OFF by default. All core features work without them.
PAYMENTS_ENABLED="false"

# ---- Payments: Razorpay (optional, stubbed when missing) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---- Payments: PayPal (planned, drops in without rework) ----
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""

# ---- Email: Resend (optional, logs to console when missing) ----
RESEND_API_KEY=""
RESEND_FROM="RishtaScore <no-reply@rishtascore.local>"

# ---- SMS: MSG91 or Twilio (optional, logs to console when missing) ----
SMS_PROVIDER=""
MSG91_AUTH_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ---- Observability (optional) ----
SENTRY_DSN=""
LOG_LEVEL="info"
